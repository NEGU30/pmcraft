/*
 * 原型局域网预览服务 —— 纯静态托管
 * 纯 Node 内置模块（http / fs / path / os），无需 npm install。
 * 启动：node server.js  或双击 start.bat / 运行 start.sh
 * 关闭：双击 close.bat / 运行 close.sh，或对助手说"关闭服务"
 *
 * 注意：本模板由 deploy-prototype.js 渲染，落盘时所有 `5178` 会被替换为最终端口。
 */
'use strict';
const http = require('http');
const fs = require('fs');
const path = require('path');
const os = require('os');

const PORT = process.env.PORT || 5178;
const ROOT = __dirname;
const MOCK_DIR = path.join(ROOT, 'mock');
const PID_FILE = path.join(MOCK_DIR, '.server.pid');

// 确保 mock/ 目录存在，并写入 PID 供关闭脚本使用
if (!fs.existsSync(MOCK_DIR)) fs.mkdirSync(MOCK_DIR, { recursive: true });
try { fs.writeFileSync(PID_FILE, String(process.pid)); } catch (e) {}

const MIME = {
  '.html': 'text/html; charset=utf-8', '.css': 'text/css; charset=utf-8',
  '.js': 'text/javascript; charset=utf-8', '.json': 'application/json; charset=utf-8',
  '.png': 'image/png', '.jpg': 'image/jpeg', '.jpeg': 'image/jpeg', '.gif': 'image/gif',
  '.svg': 'image/svg+xml', '.webp': 'image/webp', '.ico': 'image/x-icon',
  '.woff': 'font/woff', '.woff2': 'font/woff2', '.ttf': 'font/ttf'
};
// 白名单扩展名：仅允许这些静态资源被访问
const ALLOW_EXT = /\.(html|css|js|json|png|jpg|jpeg|gif|svg|webp|ico|woff|woff2|ttf|map)$/i;

function serveFile(res, file) {
  fs.readFile(file, (err, buf) => {
    if (err) { res.writeHead(404, { 'Content-Type': 'text/plain; charset=utf-8' }); res.end('404 Not Found'); return; }
    res.writeHead(200, { 'Content-Type': MIME[path.extname(file).toLowerCase()] || 'application/octet-stream' });
    res.end(buf);
  });
}

const server = http.createServer((req, res) => {
  if (req.method !== 'GET') { res.writeHead(405); res.end('405'); return; }
  const u = decodeURIComponent(req.url.split('?')[0]);
  if (u === '/' || u === '/index.html') return serveFile(res, path.join(ROOT, 'index.html'));
  // 路径穿越防护：去掉开头斜杠，剔除所有 .. 片段
  const safe = u.replace(/^\/+/, '').replace(/\.\.+/g, '');
  if (ALLOW_EXT.test(safe)) {
    const target = path.join(ROOT, safe);
    // 二次兜底：解析后的绝对路径必须仍在 ROOT 内
    if (target.startsWith(ROOT)) return serveFile(res, target);
  }
  res.writeHead(404, { 'Content-Type': 'text/plain; charset=utf-8' });
  res.end('404 Not Found');
});

function lanIPv4() {
  const out = [];
  for (const addrs of Object.values(os.networkInterfaces())) {
    for (const a of addrs) if (a.family === 'IPv4' && !a.internal) out.push(a.address);
  }
  return out;
}

server.listen(PORT, '0.0.0.0', () => {
  const ips = lanIPv4();
  console.log('====================================================');
  console.log('  prototype preview - server started');
  console.log('  Local test :  http://localhost:' + PORT + '/');
  if (ips.length) {
    console.log('  ---- Send this link to viewers (same LAN) ----');
    ips.forEach(ip => console.log('  View page  :  http://' + ip + ':' + PORT + '/'));
    if (ips.length > 1) console.log('  (Multiple NICs: pick the IP on the same subnet as them)');
  } else {
    console.log('  (No LAN IP detected - maybe offline)');
  }
  console.log('  First LAN access needs firewall: run allow-firewall.bat as admin');
  console.log('  Stop server:  double-click close.bat');
  console.log('====================================================');
});

function cleanup() { try { if (fs.existsSync(PID_FILE)) fs.unlinkSync(PID_FILE); } catch (e) {} process.exit(0); }
process.on('SIGINT', cleanup);
process.on('SIGTERM', cleanup);
